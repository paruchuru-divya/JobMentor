# JobMentor AI Environment Configuration
# Google Gemini API Key (obtain from https://aistudio.google.com/ or Google Cloud Vertex AI)
GEMINI_API_KEY=your_gemini_api_key_here

# Model name: gemini-2.5-flash, gemini-2.0-flash, or gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud Project ID (optional for local, required for Cloud Run / Firestore)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Firestore Configuration (leave blank for in-memory fallback during local testing)
FIRESTORE_DATABASE=(default)
USE_FIRESTORE_EMULATOR=false

# Server Configuration
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development
